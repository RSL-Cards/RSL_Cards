{
  "compilerOptions": {
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "composite": true,
    "strict": true,
    "downlevelIteration": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "allowJs": true,

    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@rsl/shared-config": ["../packages/shared-config/src/index.ts"],
      "@rsl/shared-constants": ["../packages/shared-constants/src/index.ts"],
      "@rsl/shared-db": ["../packages/shared-db/src/index.ts"],
      "@rsl/shared-types": ["../packages/shared-types/src/index.ts"],
      "@rsl/shared-utils": ["../packages/shared-utils/src/index.ts"]
    }
  },
  "include": ["src/**/*", "../packages/*/src/**/*"],
  "exclude": ["node_modules", "../packages/*/dist"]
}
