{
  "name": "@rsl/shared-db",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "generate": "tsx node_modules/drizzle-kit/bin.cjs generate --config drizzle.dev.config.ts",
    "migrate:dev": "drizzle-kit migrate --config drizzle.dev.config.ts",
    "migrate:qa": "drizzle-kit migrate --config drizzle.qa.config.ts",
    "migrate:prod": "drizzle-kit migrate --config drizzle.prod.config.ts",
    "seed:dev": "tsx src/seed.ts",
    "studio": "drizzle-kit studio --config drizzle.dev.config.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.38.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
