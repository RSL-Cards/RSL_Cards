{
  "expo": {
    "name": "RSL Cards Pro",
    "slug": "rsl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "rslcards",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rslcards.dealer",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.rslcards.dealer",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "@react-native-google-signin/google-signin",
      "expo-camera",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow RSL Cards to access your microphone for voice queries.",
          "speechRecognitionPermission": "Allow RSL Cards to recognize your speech for voice queries."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true,
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62fd97df-6476-4894-9c0c-242103e88a85"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/62fd97df-6476-4894-9c0c-242103e88a85"
    }
  }
}
