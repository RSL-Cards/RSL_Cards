{
  "expo": {
    "name": "RSL Cards Pro",
    "slug": "rsl",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "scheme": "rslcards",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rslcards.dealer",
      "infoPlist": {
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.156597264526-vuprt1vot9ku9nr1oos1llu5rnjv2iae"
            ]
          }
        ],
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Allow RSL Cards to access your location for local dealer card show discovery.",
        "NSCameraUsageDescription": "Allow RSL Cards to access your camera to scan sports cards.",
        "NSPhotoLibraryUsageDescription": "Allow RSL Cards to access your photo library to select card images."
      }
    },
    "android": {
      "versionCode": 17,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.rslcards.dealer",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      "@react-native-google-signin/google-signin",
      "expo-camera",
      [
        "@react-native-voice/voice",
        {
          "microphonePermission": "Allow RSL Cards to access your microphone for voice queries.",
          "speechRecognitionPermission": "Allow RSL Cards to recognize your speech for voice queries."
        }
      ],
      "expo-font",
      [
        "expo-build-properties",
        {
          "android": {
            "enableJetifier": true,
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withAndroidComponentFactory",
      "./plugins/withExcludeSupportLib",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000"
        }
      ],
      [
        "onesignal-expo-plugin",
        {
          "mode": "development"
        }
      ]
    ],
    "experiments": {
      "autolinkingModuleResolution": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "62fd97df-6476-4894-9c0c-242103e88a85"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/62fd97df-6476-4894-9c0c-242103e88a85"
    }
  }
}
